# Terrane backend configuration.
# Copy this file to backend/.env and fill in real values:
#   cp .env.example backend/.env
# Never commit backend/.env — it is gitignored.

# --- Auth ---
# Secret used to sign login tokens. REQUIRED in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# --- PayPal ---
# Create credentials at https://developer.paypal.com (Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" for testing, "live" for real payments.
PAYPAL_MODE=sandbox
# When PayPal keys are absent, checkout is disabled by default (returns 503) so
# production can never record a $0 "demo" order. Set to true ONLY for local dev.
ALLOW_DEMO_CHECKOUT=false

# --- Email (transactional) ---
# Works with any SMTP provider (Resend, Postmark, Amazon SES, SendGrid — all
# offer SMTP). Leave blank to disable email; build requests are still saved.
# SMTP_FROM defaults to SMTP_USER. SMTP_STARTTLS defaults to true; SMTP_PORT to 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_STARTTLS=true
# Owner inbox that receives a notification for every new build request.
PROOF_NOTIFY_EMAIL=
# Inbox for contact-form messages (falls back to PROOF_NOTIFY_EMAIL if blank).
CONTACT_NOTIFY_EMAIL=

# --- Admin access ---
# Comma-separated emails allowed into the /admin dashboard and admin APIs
# (list/patch build requests, contacts, stats). This is checked against the
# email on your SIGNED-IN account — so you must register an account on the site
# using one of these emails, or /admin will refuse you.
ADMIN_EMAILS=barcus@terranemaps.com

# --- Site ---
# Public base URL, used to build the approval link in proof emails
# (e.g. https://www.terranemaps.com/request/<id>). No trailing slash.
SITE_URL=https://www.terranemaps.com

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API with
# credentials. Only needed if the frontend is served from a different origin
# than the API; the docker-compose setup serves both from one origin.
# Default: https://terranemaps.com,https://www.terranemaps.com,http://localhost:3000
#CORS_ORIGINS=

# --- Rate limiting ---
# Login, register, contact, the analytics beacon and GPX upload are rate
# limited per client IP. The client IP is read from X-Forwarded-For, skipping
# this many trusted proxies from the right. The docker-compose stack is
# client -> nginx, so 1 is correct. Put Cloudflare in front (client -> CF ->
# nginx) and this MUST be 2, or every visitor is counted as one Cloudflare IP
# and real users start getting 429s.
#TRUSTED_PROXY_COUNT=1
# Set to false only for load testing. Never in production.
#RATE_LIMIT_ENABLED=true

# --- Database ---
# When using docker-compose these are set automatically to the bundled
# MongoDB service — you can leave them commented out. For manual deploys
# (see DEPLOY.md Option B) set them explicitly.
#MONGO_URL=mongodb://localhost:27017
#DB_NAME=terrane

# --- Uploads ---
# Directory for uploaded GPX files. docker-compose sets this to a persistent
# volume automatically; defaults to backend/uploads otherwise.
#UPLOAD_DIR=
