{%- comment -%}
  Terrane Guarantee — "the promise" proof-before-print section with three
  chips (blocks) and a studio CTA using the `studio_url` setting. Chips carry
  EDIT markers for shipping specifics. Scoped dark-editorial styling.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --t-bg-0: #0b1c29;
    --t-panel: #142c3e;
    --t-cream: #f2ead6;
    --t-cream-dim: #d8cfba;
    --t-rust: #cd7b41;
    --t-rust-bright: #e08b4c;
    --t-slate: #8299ac;
    --t-line: rgba(233,224,202,0.10);
    --t-line-strong: rgba(233,224,202,0.18);
    --t-display: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    --t-body: 'Inter', system-ui, sans-serif;
    --t-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;
    background: var(--t-bg-0); color: var(--t-cream); font-family: var(--t-body);
  }
  #shopify-section-{{ section.id }} .t-wrap { max-width: 1200px; margin: 0 auto; padding: 96px 24px; }
  #shopify-section-{{ section.id }} .t-head { max-width: 48rem; }
  #shopify-section-{{ section.id }} .t-kicker { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }
  #shopify-section-{{ section.id }} .t-kicker .line { width: 40px; height: 1px; background: var(--t-rust); }
  #shopify-section-{{ section.id }} .t-kicker .label { font-family: var(--t-mono); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.72rem; color: var(--t-rust); }
  #shopify-section-{{ section.id }} .t-h2 {
    font-family: var(--t-display); font-weight: 900; letter-spacing: -0.02em; line-height: 1.02;
    font-size: clamp(2.4rem, 4.5vw, 3.2rem); margin: 0;
  }
  #shopify-section-{{ section.id }} .t-h2 .accent { color: var(--t-rust); }
  #shopify-section-{{ section.id }} .t-lede { margin-top: 24px; color: var(--t-cream-dim); font-size: 1.1rem; line-height: 1.7; }
  #shopify-section-{{ section.id }} .t-chips { margin-top: 48px; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .t-chips { grid-template-columns: repeat(3, 1fr); } }
  #shopify-section-{{ section.id }} .t-chip {
    display: flex; align-items: center; gap: 12px; padding: 16px 20px;
    border: 1px solid var(--t-line-strong); background: var(--t-panel); border-radius: 2px;
  }
  #shopify-section-{{ section.id }} .t-chip .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--t-rust); flex-shrink: 0; }
  #shopify-section-{{ section.id }} .t-chip .label { font-family: var(--t-mono); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: var(--t-cream-dim); }
  #shopify-section-{{ section.id }} .t-cta-row { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 16px; }
  #shopify-section-{{ section.id }} .t-btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px;
    background: var(--t-rust); color: #1a0f07; font-weight: 700; text-decoration: none;
    border-radius: 2px; border: 1px solid var(--t-rust); font-size: 0.95rem;
  }
  #shopify-section-{{ section.id }} .t-btn:hover { background: var(--t-rust-bright); border-color: var(--t-rust-bright); }
  #shopify-section-{{ section.id }} .t-btn-ghost { background: transparent; color: var(--t-cream); border: 1px solid var(--t-line-strong); }
  #shopify-section-{{ section.id }} .t-btn-ghost:hover { border-color: var(--t-rust); color: var(--t-rust-bright); }
</style>

<div class="t-wrap">
  <div class="t-head">
    <div class="t-kicker"><span class="line"></span><span class="label">{{ section.settings.kicker }}</span></div>
    <h2 class="t-h2">{{ section.settings.heading }} <span class="accent">{{ section.settings.heading_accent }}</span></h2>
    {%- if section.settings.lede != blank -%}
      <div class="t-lede">{{ section.settings.lede }}</div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="t-chips">
      {%- for block in section.blocks -%}
        <div class="t-chip" {{ block.shopify_attributes }}>
          <span class="dot"></span>
          <span class="label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="t-cta-row">
    <a class="t-btn" href="{{ section.settings.studio_url }}">{{ section.settings.primary_label }} →</a>
    {%- if section.settings.secondary_label != blank -%}
      <a class="t-btn t-btn-ghost" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Terrane Guarantee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You approve a proof" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "before we print." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>We build the final render from survey data and send it to you first. Nothing goes on the bed until you say yes. If it is not right, we fix it.</p>" },
    { "type": "url", "id": "studio_url", "label": "Studio URL", "default": "https://studio.terranemaps.com" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Design your map" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Read the FAQ" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button URL" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Ships in ~X weeks — EDIT" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Terrane Guarantee",
      "blocks": [
        { "type": "chip", "settings": { "label": "Ships in ~X weeks — EDIT" } },
        { "type": "chip", "settings": { "label": "Free US shipping — EDIT" } },
        { "type": "chip", "settings": { "label": "Tracking included — EDIT" } }
      ]
    }
  ]
}
{% endschema %}
